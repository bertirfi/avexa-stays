# ============================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git
# ============================================

# APP CONFIG
NEXT_PUBLIC_APP_URL=https://avexastays.com

# PRICING (server-only, single source — RON is the money of record)
AVEXA_MARKUP_PERCENT=18        # AVEXA margin over Hostaway base RON, ALL listings
AVEXA_PAYMENT_FEE_PERCENT=3    # card-processing cost on top of the marked-up price
AVEXA_FX_RATE_EUR=5.25         # DISPLAY rate: 1 EUR = 5.25 RON (display-only)
AVEXA_FX_RATE_USD=4.65         # DISPLAY rate: 1 USD = 4.65 RON (display-only)

# SUPABASE (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=             # SERVER ONLY - never expose, bypasses RLS

# GOOGLE MAPS (key restricted by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# STRIPE (deferred — Wave 5; use test keys first)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# HOSTAWAY (Settings → API)
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=

# NOTE: Google OAuth credentials are configured in
# Supabase → Authentication → Providers, NOT here.

# EMAIL (BREVO)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=bookings@avexastays.com
BREVO_SENDER_NAME=AVEXA STAYS

# ANALYTICS (Wave 6)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# INTERNAL SECURITY
SYNC_SECRET=                           # generate: openssl rand -base64 32
CRON_SECRET=                           # generate: openssl rand -base64 32
