{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "coming-soon.html", "app-v2.html", "stay*.html", "stay*.jsx", "checkout*.jsx", "checkout.html", "checkout.css", "login.html", "login.css", "member-benefits.*", "my-trips.*", "profile.*", "locations.html", "search-pill.js", "v2-app.js", "v2-sections.css", "stay.css", "project", "chats", "screenshots", "_new_*"]
}
